{
  "name": "discord-to-google-sheet",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot that stores three attached images and metadata in Google Sheets",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "google-auth": "tsx src/google-auth-cli.ts",
    "build": "tsc -p tsconfig.json",
    "build:docker": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "googleapis": "^160.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
